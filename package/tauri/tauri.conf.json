{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AICompanion",
  "version": "0.1.0",
  "identifier": "app.aicompanion.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:38888"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Companion",
        "width": 720,
        "height": 560,
        "resizable": true,
        "url": "http://127.0.0.1:38888"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/companion-server"],
    "resources": {
      "../../frontend/dist": "frontend"
    }
  }
}
